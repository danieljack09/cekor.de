---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Featured-article slider, zero JS: up to 5 radios + CSS :checked. Dots and
// the prev/next arrows are label[for] pointing at a radio. Used at the top of
// the landing page and of /mk/novosti/ - one component, so the two can never
// drift apart. Slides come from heroSlides() in src/lib/articles.ts.

export interface HeroSlide {
  href: string | null;
  title: string;
  description: string;
  date: string | null;
  readTime: string | null;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  slides: HeroSlide[];
  /** Prefix for the radio name and ids, unique per page. */
  id: string;
}

const { slides, id } = Astro.props;

// One slide: nothing to move between, so no arrows, no dots, no rotation.
const single = slides.length < 2;

// Auto-rotation, still zero JS. An extra "auto" radio is checked on load;
// while it is, CSS keyframes show each slide for SLIDE_SECONDS in turn. The
// moment the reader clicks an arrow or a dot, that slide's radio is checked
// instead and rotation stops - the reader is in control from then on.
// Each panel runs the same cycle, offset by a negative delay so slide 1 is
// showing at t=0, slide 2 at t=10s, and so on.
const SLIDE_SECONDS = 10;
const n = slides.length;
const auto = !single;
const delay = (i: number) => `${-(((n - i) % n) * SLIDE_SECONDS)}s`;
---

<div
  class:list={['hero-slider', single && 'hero-slider--single', auto && `hero-slider--auto${n}`]}
  style={auto ? `--cycle: ${n * SLIDE_SECONDS}s` : undefined}
>
  {
    slides.map((_, i) => (
      <input
        type="radio"
        name={`${id}-slide`}
        id={`${id}-slide-${i + 1}`}
        class="hero-slider__radio visually-hidden"
        checked={i === 0 && !auto}
      />
    ))
  }
  {
    auto && (
      <input
        type="radio"
        name={`${id}-slide`}
        id={`${id}-slide-auto`}
        class="hero-slider__radio hero-slider__radio--auto visually-hidden"
        checked
        aria-label="Автоматски"
      />
    )
  }

  <div class="hero-slider__viewport">
    {
      slides.map((slide, i) => {
        const prev = i === 0 ? slides.length : i;
        const next = i === slides.length - 1 ? 1 : i + 2;
        return (
          <div class="hero-slider__panel" style={auto ? `--delay: ${delay(i)}` : undefined}>
            {/* The article's own card image when it has one, otherwise
                a flat placeholder block - never a fabricated photo.
                Only the first slide is visible on load, so only it
                loads eagerly. */}
            {slide.image ? (
              <Image
                class="hero-slider__image"
                src={slide.image}
                alt={slide.imageAlt ?? ''}
                widths={[480, 800]}
                sizes="(max-width: 640px) 100vw, 520px"
                format="webp"
                quality={60}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <div class="hero-slider__image" aria-hidden="true" />
            )}

            <div class="hero-slider__content">
              {slide.href ? (
                <a class="hero-slider__title" href={slide.href}>
                  {slide.title}
                </a>
              ) : (
                <p class="hero-slider__title">{slide.title}</p>
              )}
              <p class="hero-slider__excerpt">{slide.description}</p>
              {(slide.date || slide.readTime) && (
                <div class="hero-slider__meta">
                  {slide.date && <span>{slide.date}</span>}
                  {slide.readTime && <span>{slide.readTime}</span>}
                </div>
              )}
            </div>

            <label
              class="hero-slider__arrow hero-slider__arrow--prev"
              for={`${id}-slide-${prev}`}
              aria-label="Претходна вест"
            >
              ‹
            </label>
            <label
              class="hero-slider__arrow hero-slider__arrow--next"
              for={`${id}-slide-${next}`}
              aria-label="Следна вест"
            >
              ›
            </label>
          </div>
        );
      })
    }
  </div>

  <div class="hero-slider__dots">
    {
      slides.map((_, i) => (
        <label
          class="hero-slider__dot"
          for={`${id}-slide-${i + 1}`}
          style={auto ? `--delay: ${delay(i)}` : undefined}
          aria-label={`Вест ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<style>
  /* position: relative here is deliberate: the hidden radios below need a
     local containing block, or the browser's focus-follow-scroll can jump
     the page to the top on click (the bug the stepper hit earlier). */
  .hero-slider {
    position: relative;
  }

  .hero-slider__viewport {
    position: relative;
    display: grid;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-hover);
  }

  /* All 5 panels stacked in one grid cell - only the :checked-matching one
     is opaque/interactive, the rest sit behind it at opacity 0. */
  .hero-slider__panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 320px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  @media (max-width: 640px) {
    .hero-slider__panel {
      grid-template-columns: 1fr;
      grid-template-rows: 200px auto;
      min-height: 0;
    }
  }

  .hero-slider__image {
    background: var(--green-pale);
  }

  img.hero-slider__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .hero-slider__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--surface-raised);
    padding: var(--space-5);
  }

  .hero-slider__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
    margin-block-end: var(--space-2);
  }

  a.hero-slider__title:hover {
    color: var(--green);
  }

  .hero-slider__excerpt {
    color: var(--ink-quiet);
    line-height: 1.7;
    margin-block-end: var(--space-3);
  }

  .hero-slider__meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--ink-quiet);
    border-block-start: 1px solid var(--rule);
    padding-block-start: var(--space-2);
    margin-block-start: auto;
  }

  .hero-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface-raised);
    box-shadow: var(--shadow);
    color: var(--green);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  .hero-slider__arrow--prev {
    inset-inline-start: var(--space-3);
  }

  .hero-slider__arrow--next {
    inset-inline-end: var(--space-3);
  }

  .hero-slider__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .hero-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--green-pale);
    cursor: pointer;
    transition:
      width 0.2s ease,
      background-color 0.2s ease;
  }

  /* Structural position rules - which panel is opaque/interactive, which
     dot is the active one. :has() reaches each radio by its position,
     not its id, so two sliders on one page cannot collide. */
  .hero-slider:has(.hero-slider__radio:nth-of-type(1):checked) .hero-slider__panel:nth-of-type(1) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slider:has(.hero-slider__radio:nth-of-type(1):checked) .hero-slider__dot:nth-of-type(1) {
    width: 20px;
    background: var(--green);
  }

  .hero-slider:has(.hero-slider__radio:nth-of-type(2):checked) .hero-slider__panel:nth-of-type(2) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slider:has(.hero-slider__radio:nth-of-type(2):checked) .hero-slider__dot:nth-of-type(2) {
    width: 20px;
    background: var(--green);
  }

  .hero-slider:has(.hero-slider__radio:nth-of-type(3):checked) .hero-slider__panel:nth-of-type(3) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slider:has(.hero-slider__radio:nth-of-type(3):checked) .hero-slider__dot:nth-of-type(3) {
    width: 20px;
    background: var(--green);
  }

  .hero-slider:has(.hero-slider__radio:nth-of-type(4):checked) .hero-slider__panel:nth-of-type(4) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slider:has(.hero-slider__radio:nth-of-type(4):checked) .hero-slider__dot:nth-of-type(4) {
    width: 20px;
    background: var(--green);
  }

  .hero-slider:has(.hero-slider__radio:nth-of-type(5):checked) .hero-slider__panel:nth-of-type(5) {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }
  .hero-slider:has(.hero-slider__radio:nth-of-type(5):checked) .hero-slider__dot:nth-of-type(5) {
    width: 20px;
    background: var(--green);
  }

  .hero-slider--single .hero-slider__arrow,
  .hero-slider--single .hero-slider__dots {
    display: none;
  }

  /* --- Auto-rotation --------------------------------------------------
     Only while the "auto" radio is checked (see the frontmatter). One
     keyframe set per slide count, since percentages cannot be computed:
     each slide owns 1/n of the cycle and cross-fades over its first and
     last 1%. Pauses while hovered or focused, so it never moves under the
     reader's pointer or keyboard. */

  @keyframes hero-panel-2 {
    0% { opacity: 0; pointer-events: auto; z-index: 1; }
    1%, 50% { opacity: 1; pointer-events: auto; z-index: 1; }
    51%, 100% { opacity: 0; pointer-events: none; z-index: 0; }
  }
  @keyframes hero-dot-2 {
    0%, 50% { width: 20px; background: var(--green); }
    50.001%, 100% { width: 8px; background: var(--green-pale); }
  }
  .hero-slider--auto2:has(.hero-slider__radio--auto:checked) .hero-slider__panel {
    animation: hero-panel-2 var(--cycle) linear var(--delay) infinite;
  }
  .hero-slider--auto2:has(.hero-slider__radio--auto:checked) .hero-slider__dot {
    animation: hero-dot-2 var(--cycle) linear var(--delay) infinite;
  }

  @keyframes hero-panel-3 {
    0% { opacity: 0; pointer-events: auto; z-index: 1; }
    1%, 33.333% { opacity: 1; pointer-events: auto; z-index: 1; }
    34.333%, 100% { opacity: 0; pointer-events: none; z-index: 0; }
  }
  @keyframes hero-dot-3 {
    0%, 33.333% { width: 20px; background: var(--green); }
    33.334%, 100% { width: 8px; background: var(--green-pale); }
  }
  .hero-slider--auto3:has(.hero-slider__radio--auto:checked) .hero-slider__panel {
    animation: hero-panel-3 var(--cycle) linear var(--delay) infinite;
  }
  .hero-slider--auto3:has(.hero-slider__radio--auto:checked) .hero-slider__dot {
    animation: hero-dot-3 var(--cycle) linear var(--delay) infinite;
  }

  @keyframes hero-panel-4 {
    0% { opacity: 0; pointer-events: auto; z-index: 1; }
    1%, 25% { opacity: 1; pointer-events: auto; z-index: 1; }
    26%, 100% { opacity: 0; pointer-events: none; z-index: 0; }
  }
  @keyframes hero-dot-4 {
    0%, 25% { width: 20px; background: var(--green); }
    25.001%, 100% { width: 8px; background: var(--green-pale); }
  }
  .hero-slider--auto4:has(.hero-slider__radio--auto:checked) .hero-slider__panel {
    animation: hero-panel-4 var(--cycle) linear var(--delay) infinite;
  }
  .hero-slider--auto4:has(.hero-slider__radio--auto:checked) .hero-slider__dot {
    animation: hero-dot-4 var(--cycle) linear var(--delay) infinite;
  }

  @keyframes hero-panel-5 {
    0% { opacity: 0; pointer-events: auto; z-index: 1; }
    1%, 20% { opacity: 1; pointer-events: auto; z-index: 1; }
    21%, 100% { opacity: 0; pointer-events: none; z-index: 0; }
  }
  @keyframes hero-dot-5 {
    0%, 20% { width: 20px; background: var(--green); }
    20.001%, 100% { width: 8px; background: var(--green-pale); }
  }
  .hero-slider--auto5:has(.hero-slider__radio--auto:checked) .hero-slider__panel {
    animation: hero-panel-5 var(--cycle) linear var(--delay) infinite;
  }
  .hero-slider--auto5:has(.hero-slider__radio--auto:checked) .hero-slider__dot {
    animation: hero-dot-5 var(--cycle) linear var(--delay) infinite;
  }

  .hero-slider:hover .hero-slider__panel,
  .hero-slider:hover .hero-slider__dot,
  .hero-slider:focus-within .hero-slider__panel,
  .hero-slider:focus-within .hero-slider__dot {
    animation-play-state: paused;
  }

  /* No motion wanted: no rotation. Slide 1 just stays, as if picked. */
  @media (prefers-reduced-motion: reduce) {
    .hero-slider:has(.hero-slider__radio--auto:checked) .hero-slider__panel,
    .hero-slider:has(.hero-slider__radio--auto:checked) .hero-slider__dot {
      animation: none;
    }
    .hero-slider:has(.hero-slider__radio--auto:checked) .hero-slider__panel:nth-of-type(1) {
      opacity: 1;
      pointer-events: auto;
      z-index: 1;
    }
    .hero-slider:has(.hero-slider__radio--auto:checked) .hero-slider__dot:nth-of-type(1) {
      width: 20px;
      background: var(--green);
    }
  }
</style>
