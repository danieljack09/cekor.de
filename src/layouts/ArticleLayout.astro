---
import BaseLayout from './BaseLayout.astro';
import SequenceStrip from '../components/SequenceStrip.astro';
import SummaryBox from '../components/SummaryBox.astro';
import SourceLine from '../components/SourceLine.astro';
import NextStep from '../components/NextStep.astro';
import NextStepPill from '../components/NextStepPill.astro';
import ArticleImage from '../components/ArticleImage.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { defaultLocale, intlLocale, type Locale } from '../i18n/config';
import { sectionOfArticle } from '../data/sections';
import { imageCreditText } from '../lib/articles';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
  locale?: Locale;
}

const { entry, locale = defaultLocale } = Astro.props;
const { title, description, summary, sequenceStep, sources, updated, date } = entry.data;

// An article marks its own section in the header nav: news by its folder,
// everything else belongs to Почеток во Германија.
const activeSection = sectionOfArticle(entry.id);

// News carries its date above the title: "16 октомври 2026".
const newsDate =
  date &&
  new Intl.DateTimeFormat(intlLocale[locale], { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  activeSection={activeSection}
>
  <article class="article wrap">
    {/* Only rendered when the article is part of the sequence. */}
    {sequenceStep !== null && <SequenceStrip step={sequenceStep} locale={locale} />}

    {newsDate && <p class="article__date"><time datetime={date!.toISOString().slice(0, 10)}>{newsDate}</time></p>}

    {/* The compact pill sits beside the title for a reader who wants to
        skip ahead immediately; it wraps onto its own line below the title
        when there isn't room. The full card repeats at the very bottom for
        one who reads through - see NextStep.astro. */}
    <div class="article__heading">
      <h1>{title}</h1>
      {sequenceStep !== null && <NextStepPill step={sequenceStep} locale={locale} />}
    </div>

    <SummaryBox summary={summary} locale={locale} />

    {
      entry.data.image && (
        <ArticleImage
          image={entry.data.image}
          alt={entry.data.imageAlt ?? ''}
          credit={imageCreditText(locale, entry.data)}
          source={entry.data.imageSource}
          license={entry.data.imageLicense}
          licenseUrl={entry.data.imageLicenseUrl}
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    <SourceLine sources={sources} updated={updated} locale={locale} />

    {sequenceStep !== null && <NextStep step={sequenceStep} locale={locale} />}

    <RelatedArticles slugs={entry.data.related} locale={locale} />
  </article>
</BaseLayout>

<style>
  .article__date {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--ink-quiet);
    margin-block-end: var(--space-1);
  }

  /* Title + pill in one row; wraps the pill onto its own line below the
     title when there isn't room beside it - no media query needed.
     The H1 needs a zero flex-basis (not "auto"): with "auto" the wrap
     algorithm sizes it by its max-content width - the full title on one
     line - and decides the pill can't fit beside it before the title ever
     gets a chance to shrink, pushing the pill down even on a wide screen. */
  .article__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-3);
  }

  .article__heading h1 {
    margin-block-end: 0;
    flex: 1 1 0%;
    min-width: 0;
  }
</style>
