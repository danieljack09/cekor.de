---
import { defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

// The button always offers to switch TO the theme it isn't currently in.
// Both labels are present in the DOM; only one is read by the time the
// button renders, via aria-label - but since we don't know the active
// theme at build time (it's a client-side choice), we keep the label
// generic and let the two icons carry the state visually, same as the
// anti-flash approach everywhere else on this feature.
const label = `${t('theme.toLight')} / ${t('theme.toDark')}`;
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label={label}>
  <svg
    class="theme-toggle__sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    />
  </svg>
  <svg
    class="theme-toggle__moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" />
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var current =
        root.getAttribute('data-theme') ||
        (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      var next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('cekor-theme', next);
      } catch (e) {
        /* Private Browsing / storage blocked - the choice just won't persist. */
      }
    });
  })();
</script>
