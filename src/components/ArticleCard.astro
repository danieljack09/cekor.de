---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  description: string;
  /** Small line above the title - a step number ("1 / 9"), a date, or omitted. */
  badge?: string;
  /** Small line below the description - a category label, or omitted. */
  meta?: string;
  /** The one step a new arrival is about to start. See .rail in global.css. */
  current?: boolean;
  /** Article's card image, from src/assets/articles/. Omitted: no image. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, title, description, badge, meta, current = false, image, imageAlt } = Astro.props;
---

<a class:list={['card', current && 'card--current', image && 'card--image']} href={href}>
  {
    image && (
      <Image
        class="card__image"
        src={image}
        alt={imageAlt ?? ''}
        widths={[360, 640]}
        sizes="(max-width: 640px) 100vw, 340px"
        format="webp"
        quality={60}
        loading="lazy"
        decoding="async"
      />
    )
  }
  {badge && <span class="card__badge">{badge}</span>}
  <span class="card__title">{title}</span>
  <span class="card__desc">{description}</span>
  {meta && <span class="card__meta">{meta}</span>}
</a>
