---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { activeLocales, intlLocale, localePath, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { sectionById } from '../../../data/sections';
import { articlePath, newsArticles } from '../../../lib/articles';

export function getStaticPaths() {
  return activeLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const section = sectionById('novosti');

const news = await newsArticles(locale);
const formatDate = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format;
---

<BaseLayout
  title={section.label}
  description={section.intro}
  locale={locale}
  activeSection="novosti"
  wide
>
  <div class="wrap wrap--wide">
    <h1>{section.label}</h1>
    <p class="intro">{section.intro}</p>

    {
      news.length === 0 ? (
        <div class="empty">
          <p class="empty__headline">{t('home.empty')}</p>
          <p class="empty__note">{t('novosti.emptyNote')}</p>
        </div>
      ) : (
        <ul class="card-grid card-grid--3up">
          {news.map((article) => (
            <li>
              <ArticleCard
                href={localePath(locale, articlePath(article))}
                title={article.data.title}
                description={article.data.description}
                badge={formatDate(article.data.date!)}
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
