---
import { defaultLocale, intlLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  /** At least one. Enforced by the content schema, always https. */
  sources: { label: string; url: string }[];
  updated: Date;
  locale?: Locale;
}

const { sources, updated, locale = defaultLocale } = Astro.props;

// The domain is the trust signal: bmdv.bund.de says more about a claim than
// the title of the page it points at. "www." carries no information, so it goes.
const withDomain = sources.map((source) => ({
  ...source,
  domain: new URL(source.url).hostname.replace(/^www\./, ''),
}));
const t = useTranslations(locale);

// Macedonian date format: "30 септември 2026"
const checked = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(updated);
---

<footer class="source">
  <div class="source__box">
    <svg class="source__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7z" />
      <path d="M14 3v4h4" />
      <line x1="9" y1="12" x2="15" y2="12" />
      <line x1="9" y1="16" x2="13" y2="16" />
    </svg>

    <div class="source__list">
      <p class="source__title">{t('article.sources')}</p>
      <ul>
        {
          withDomain.map((source) => (
            <li>
              {/* Source names are German proper nouns and stay in German. */}
              <a href={source.url} target="_blank" rel="noopener external" lang="de">
                {source.label}
              </a>
              <span class="source__domain">{source.domain}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="source__checked">
    {t('article.checked')}:{' '}
    <time datetime={updated.toISOString().slice(0, 10)}>{checked}</time>
  </p>
</footer>

<style>
  .source {
    margin-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
    padding-block-start: var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .source__checked {
    color: var(--ink-quiet);
    /* Below the list: the sources are the point, the date is the footnote. */
    margin-block-start: var(--space-3);
    margin-block-end: 0;
  }

  .source__box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .source__icon {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    /* Optical alignment with the first line of text. */
    margin-block-start: 0.2em;
    stroke: var(--green);
    stroke-width: 1.6;
    stroke-linejoin: round;
    fill: none;
  }

  .source__title {
    font-weight: 600;
    color: var(--green);
    margin-block-end: 0;
  }

  .source__list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .source__list li + li {
    margin-block-start: var(--space-2);
  }

  /* Each source is two lines: the label, then where it comes from. */
  .source__list a {
    display: block;
  }

  .source__domain {
    display: block;
    font-size: 0.9em;
    color: var(--ink);
  }
</style>
