# Cloudflare Pages response headers.

# Fonts are served from /fonts/ under stable, unhashed names, so they get no
# cache busting from the filename. Cache them hard anyway - the file contents
# only change when the typeface changes, and re-downloading 64KB of font on
# every visit is the single worst thing we could do to a metered connection.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own bundles are content-hashed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
