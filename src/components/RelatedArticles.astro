---
// Up to two cards under an article, from its `related` frontmatter.
// Every target was checked in src/lib/validate-articles.ts, so each card
// links a published article. Renders nothing when the list is empty.
import { getEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { defaultLocale, intlLocale, localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  /** Slugs after the locale: "starlink-vo-germanija", "novosti/x". */
  slugs: string[];
  locale?: Locale;
}

const { slugs, locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const entries = (
  await Promise.all(
    slugs.map(async (slug) => ({ slug, article: await getEntry('articles', `${locale}/${slug}`) }))
  )
).filter((e) => e.article !== undefined);

// News cards carry their date, as on the Новости page.
const formatDate = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format;
---

{
  entries.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{t('article.related')}</h2>
      <ul class="card-grid">
        {entries.map(({ slug, article }) => (
          <li>
            <ArticleCard
              href={localePath(locale, slug)}
              title={article!.data.title}
              description={article!.data.description}
              image={article!.data.image}
              imageAlt={article!.data.imageAlt}
              badge={article!.data.date ? formatDate(article!.data.date) : undefined}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin-block-start: var(--space-5);
  }
</style>
