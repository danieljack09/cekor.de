---
import BaseLayout from './BaseLayout.astro';
import SequenceStrip from '../components/SequenceStrip.astro';
import SummaryBox from '../components/SummaryBox.astro';
import SourceLine from '../components/SourceLine.astro';
import NextStep from '../components/NextStep.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { categoryOfStep } from '../data/sequence';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
  locale?: Locale;
}

const { entry, locale = defaultLocale } = Astro.props;
const { title, description, summary, sequenceStep, sources, updated } = entry.data;

// An article marks its own category in the header nav, read from sequence.ts
// rather than stored on the article.
const activeCategory = sequenceStep !== null ? categoryOfStep(sequenceStep) : undefined;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  activeCategory={activeCategory}
>
  <article class="article wrap">
    {/* Only rendered when the article is part of the sequence. */}
    {sequenceStep !== null && <SequenceStrip step={sequenceStep} locale={locale} />}

    <h1>{title}</h1>

    <SummaryBox summary={summary} locale={locale} />

    <div class="prose">
      <slot />
    </div>

    <SourceLine sources={sources} updated={updated} locale={locale} />

    {sequenceStep !== null && <NextStep step={sequenceStep} locale={locale} />}
  </article>
</BaseLayout>
