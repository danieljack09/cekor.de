---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activeLocales, intlLocale, localePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { publishedSteps, stepNumber } from '../../data/sequence';
import { publishedSections } from '../../data/sections';
import { articlePath, newsArticles } from '../../lib/articles';

export function getStaticPaths() {
  return activeLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

// How many items each section previews here. The full list is one link away.
const PREVIEW = 3;

// One block per published section, read from src/data/sections.ts. An
// unpublished section is not shown at all - there is no page to link to.
const sections = publishedSections();

// The steps come from src/data/sequence.ts; only published ones are links.
const steps = publishedSteps().slice(0, PREVIEW);
const news = (await newsArticles(locale)).slice(0, PREVIEW);

const formatDate = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format;
---

{/* No `title`: BaseLayout composes the homepage pattern, Чекор — tagline. */}
<BaseLayout description={t('site.description')} locale={locale} showTagline>
  <div class="wrap">
    {
      sections.map((section) => {
        const href = localePath(locale, section.slug);
        return (
          <section class="block">
            <h2 class="block__heading">
              <a href={href}>{section.label}</a>
            </h2>
            <p class="block__intro">{section.intro}</p>

            {section.id === 'pocetok' &&
              (steps.length === 0 ? (
                <p class="block__soon">{t('home.empty')}</p>
              ) : (
                <>
                  <ul class="link-list">
                    {steps.map((step) => (
                      <li>
                        <a href={localePath(locale, step.slug)}>
                          {stepNumber(step)}. {step.title}
                        </a>
                        <span class="link-list__desc">{step.description}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="more">
                    <a href={href}>{t('pocetok.all')} →</a>
                  </p>
                </>
              ))}

            {section.id === 'novosti' &&
              (news.length === 0 ? (
                <p class="block__soon">{t('home.empty')}</p>
              ) : (
                <>
                  <ul class="link-list">
                    {news.map((article) => (
                      <li>
                        <span class="link-list__meta">{formatDate(article.data.date!)}</span>
                        <a href={localePath(locale, articlePath(article))}>{article.data.title}</a>
                        <span class="link-list__desc">{article.data.description}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="more">
                    <a href={href}>{t('novosti.all')} →</a>
                  </p>
                </>
              ))}
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .block + .block {
    margin-block-start: var(--space-6);
  }

  .block__heading {
    margin-block-start: 0;
  }

  /* The link inherits the heading's colour and size; only the underline marks
     it as a link. */
  .block__heading a {
    color: inherit;
    text-decoration-thickness: 1px;
  }

  .block__heading a:hover {
    text-decoration-thickness: 2px;
  }

  .block__intro {
    color: var(--ink-quiet);
    margin-block-end: var(--space-2);
  }

  .block__soon {
    font-family: var(--font-ui);
    color: var(--ink-quiet);
    margin-block-end: 0;
  }
</style>
