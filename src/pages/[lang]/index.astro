---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SequenceRail from '../../components/SequenceRail.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import { activeLocales, intlLocale, localePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { publishedSteps, stepNumber, totalSteps } from '../../data/sequence';
import { publishedSections } from '../../data/sections';
import { articlePath, newsArticles } from '../../lib/articles';

export function getStaticPaths() {
  return activeLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

// News grows without bound; cap the homepage teaser. There is no cap on the
// steps - there are only ever nine, and the scroll rail handles the row fine.
const PREVIEW_NEWS = 6;

// One block per published section, read from src/data/sections.ts. An
// unpublished section is not shown at all - there is no page to link to.
const sections = publishedSections();

// The steps come from src/data/sequence.ts; only published ones are links.
// The first one becomes the spotlight CTA below; the rest scroll in a rail.
const allSteps = publishedSteps();
const [firstStep, ...restSteps] = allSteps;
const news = (await newsArticles(locale)).slice(0, PREVIEW_NEWS);

const formatDate = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format;
---

{/* No `title`: BaseLayout composes the homepage pattern, Чекор — tagline. */}
<BaseLayout description={t('site.description')} locale={locale} showTagline wide>
  <div class="wrap wrap--wide">
    {
      sections.map((section) => {
        const href = localePath(locale, section.slug);
        return (
          <section class="block">
            <h2 class="block__heading">
              <a href={href}>{section.label}</a>
            </h2>
            <p class="block__intro">{section.intro}</p>

            {section.id === 'pocetok' && <SequenceRail />}

            {section.id === 'pocetok' &&
              (!firstStep ? (
                <p class="block__soon">{t('home.empty')}</p>
              ) : (
                <>
                  <SpotlightCard
                    href={localePath(locale, firstStep.slug)}
                    eyebrow={t('home.start')}
                    title={firstStep.title}
                    description={firstStep.description}
                  />

                  {restSteps.length > 0 && (
                    <div class="rail-scroll" tabindex="0" role="group" aria-label={section.label}>
                      <ul class="rail-scroll__track">
                        {restSteps.map((step) => (
                          <li>
                            <ArticleCard
                              href={localePath(locale, step.slug)}
                              title={step.title}
                              description={step.description}
                              badge={`${stepNumber(step)} / ${totalSteps}`}
                            />
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <p class="more">
                    <a href={href}>{t('pocetok.all')} →</a>
                  </p>
                </>
              ))}

            {section.id === 'novosti' &&
              (news.length === 0 ? (
                <p class="block__soon">{t('home.empty')}</p>
              ) : (
                <>
                  <div class="rail-scroll" tabindex="0" role="group" aria-label={section.label}>
                    <ul class="rail-scroll__track">
                      {news.map((article) => (
                        <li>
                          <ArticleCard
                            href={localePath(locale, articlePath(article))}
                            title={article.data.title}
                            description={article.data.description}
                            badge={formatDate(article.data.date!)}
                          />
                        </li>
                      ))}
                    </ul>
                  </div>
                  <p class="more">
                    <a href={href}>{t('novosti.all')} →</a>
                  </p>
                </>
              ))}
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .block + .block {
    margin-block-start: var(--space-6);
  }

  .block__heading {
    margin-block-start: 0;
  }

  /* The link inherits the heading's colour and size; only the underline marks
     it as a link. */
  .block__heading a {
    color: inherit;
    text-decoration-thickness: 1px;
  }

  .block__heading a:hover {
    text-decoration-thickness: 2px;
  }

  .block__intro {
    color: var(--ink-quiet);
    margin-block-end: var(--space-2);
  }

  .block__soon {
    font-family: var(--font-ui);
    color: var(--ink-quiet);
    margin-block-end: 0;
  }
</style>
