---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { activeLocales, intlLocale, localePath, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { sectionById } from '../../../data/sections';
import { articlePath, newsArticles } from '../../../lib/articles';

export function getStaticPaths() {
  return activeLocales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const section = sectionById('novosti');

const news = await newsArticles(locale);
const formatDate = new Intl.DateTimeFormat(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format;
---

<BaseLayout
  title={section.label}
  description={section.intro}
  locale={locale}
  activeSection="novosti"
>
  <div class="wrap">
    <h1>{section.label}</h1>
    <p class="intro">{section.intro}</p>

    {
      news.length === 0 ? (
        <div class="empty">
          <p class="empty__headline">{t('home.empty')}</p>
          <p class="empty__note">{t('novosti.emptyNote')}</p>
        </div>
      ) : (
        <ul class="link-list">
          {news.map((article) => (
            <li>
              <span class="link-list__meta">{formatDate(article.data.date!)}</span>
              <a href={localePath(locale, articlePath(article))}>{article.data.title}</a>
              <span class="link-list__desc">{article.data.description}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
