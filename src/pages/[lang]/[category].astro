---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activeLocales, localePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { byCategory, categories, categoryMeta, stepNumber, type Category } from '../../data/sequence';

// One page per category, per locale. getStaticPaths only emits the three
// category slugs, so this route cannot swallow an article URL - and
// validate-articles.ts refuses an article that tries to use one of them.
export function getStaticPaths() {
  return activeLocales.flatMap((lang) =>
    categories.map((category) => ({
      params: { lang, category: categoryMeta[category].slug },
      props: { category },
    }))
  );
}

const locale = Astro.params.lang as Locale;
const { category } = Astro.props as { category: Category };
const t = useTranslations(locale);

const meta = categoryMeta[category];

// Read from src/data/sequence.ts. Nothing here duplicates that list.
const steps = byCategory(category);

// Articles in this category that are NOT one of the nine steps. They carry a
// `category` in their own frontmatter; the nine steps get theirs from
// sequence.ts and may not set the field at all. Listed under the steps so the
// sequence still reads as the spine of the page.
const others = (await getCollection('articles'))
  .filter((a) => a.id.startsWith(`${locale}/`))
  .filter((a) => a.data.sequenceStep === null && a.data.category === category)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, locale));
---

<BaseLayout
  title={meta.label}
  description={meta.intro}
  locale={locale}
  activeCategory={category}
>
  <div class="wrap">
    <h1>{meta.label}</h1>
    <p class="intro">{meta.intro}</p>

    {
      steps.length === 0 && others.length === 0 ? (
        <div class="empty">
          <p class="empty__headline">{t('home.empty')}</p>
          <p class="empty__note">{t('home.emptyNote')}</p>
        </div>
      ) : (
        <>
          {steps.length > 0 && (
            <ul class="steps">
              {steps.map((step) => (
                <li>
                  <a href={localePath(locale, step.slug)}>
                    {stepNumber(step)}. {step.title}
                  </a>
                  <span class="steps__desc">{step.description}</span>
                </li>
              ))}
            </ul>
          )}

          {others.length > 0 && (
            <>
              <h2 class="other">{t('category.other')}</h2>
              <ul class="steps">
                {others.map((article) => (
                  <li>
                    <a href={localePath(locale, article.id.split('/').slice(1).join('/'))}>
                      {article.data.title}
                    </a>
                    <span class="steps__desc">{article.data.description}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .intro {
    color: var(--ink-quiet);
    margin-block-end: var(--space-4);
  }

  .empty__headline {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--green);
    margin-block-end: var(--space-1);
  }

  .empty__note {
    color: var(--ink-quiet);
    margin-block-end: 0;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
  }

  .steps li {
    margin: 0;
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--rule);
  }

  /* Separates the off-sequence list from the nine steps without a card or a
     rule: the steps above are numbered, these are not. */
  .other {
    font-size: 1rem;
    color: var(--ink-quiet);
    margin-block: var(--space-4) var(--space-1);
  }

  .steps__desc {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-quiet);
  }
</style>
